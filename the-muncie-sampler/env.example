# Copy this file to .env and fill in values. Don't commit .env.

# Database (SQLite file for local development)
DATABASE_URL="file:./dev.db"

# Base URL of the app. Use the real site address when deployed.
BETTER_AUTH_URL=http://localhost:3000

# Secret used to sign sessions. Generate one by running in a terminal:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=